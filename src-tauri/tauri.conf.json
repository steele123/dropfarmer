{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dropfarmer",
  "version": "0.1.6",
  "identifier": "app.dropfarmer.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dropfarmer",
        "decorations": false,
        "width": 1280,
        "height": 860,
        "minWidth": 920,
        "minHeight": 640,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.md"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEODdFRDA2NUIxRDRDODEKUldTQlRCMWJCdTJIalFEWlZBci9CazRkNTF4ZFdPNUoydlBIbFNHaWN2TWNFRmExZysrT0IvcmgK",
      "endpoints": [
        "https://github.com/steele123/dropfarmer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
